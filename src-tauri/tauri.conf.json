{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirmalion",
  "version": "0.9.18",
  "identifier": "com.mirmalion.desktop",
  "build": {
    "beforeDevCommand": "ng serve",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/mirmalion/browser"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:4200 http://localhost:4200; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://mirmalion.web.app/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MzhGODM0QTMxMUVBRkMKUldUODZoR2pOUGc0dDNNVVRiV2liS2t4dVJhcUtCZHpqRmhMZHpZQm1jVEU0VmhsYWFtL21sQysK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "models/DiarizerModels/": "DiarizerModels/",
      "../CREDITS.md": "CREDITS.md"
    },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "Developer ID Application: romain sauvez (7A9FXQYJA2)",
      "frameworks": ["target/swift/dist/libMirmalionNative.dylib"]
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
