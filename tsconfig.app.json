/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `$localize` est une **variable globale** fournie par `@angular/localize`, pas un import.
    // Sans ce type, tout appel depuis du TypeScript est une erreur de compilation — et c'est
    // ainsi qu'on localise une liste d'options (voir `FormOption`).
    "types": ["@angular/localize"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
